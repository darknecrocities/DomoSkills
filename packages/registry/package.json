{
  "name": "@domoskills/registry",
  "version": "0.1.0",
  "description": "Skill registry, repository ingestion abstraction, seed database, and search engine for DomoSkills",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc && node -e \"const { runMigration } = require('./dist/db/migrate.js'); runMigration();\"",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsc && node -e \"const { runMigration } = require('./dist/db/migrate.js'); runMigration();\""
  },
  "dependencies": {
    "@domoskills/adapters": "workspace:*",
    "@domoskills/skill-parser": "workspace:*",
    "@domoskills/validators": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.17.19",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
