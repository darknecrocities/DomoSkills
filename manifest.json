{
  "schema": 2,
  "required_executas": [],
  "optional_executas": [],
  "permissions": [
    "storage.read",
    "storage.write",
    "chat.append_artifact",
    "llm.complete"
  ],
  "system_prompt_addendum": "You are DomoSkills Assistant. When the user wants to discover, install, or audit skills for AI coding agents (Google Antigravity, Claude Code, Cursor, Codex), summon the DomoSkills marketplace via open_app_view('main'). Help developers find the right SKILL.md packages and run npx domoskills add commands.",
  "user_message_prefix_template": "[DomoSkills] {user_message}",
  "tags": ["developer-tools", "ai-agents", "skills", "marketplace", "productivity"],
  "ui": {
    "bundle": {
      "format": "static-spa",
      "entry": "index.html",
      "external_origins": [
        "https://web-beta-six-81.vercel.app",
        "https://api.github.com"
      ]
    },
    "views": [
      {
        "name": "main",
        "title": "DomoSkills - AI Agent Skills Marketplace",
        "default": true,
        "entry": "index.html",
        "min_size": { "w": 640, "h": 480 },
        "default_size": { "w": 1200, "h": 800 },
        "max_size": { "w": 2560, "h": 1440 },
        "single_instance": true,
        "summary_template": "DomoSkills Marketplace"
      }
    ],
    "host_api": {
      "chat": ["append_artifact"],
      "storage": ["get", "set", "delete", "list"],
      "window": ["set_title", "open_view", "close"],
      "llm": ["complete", "stream"]
    },
    "csp_overrides": {
      "frame-src": ["https://web-beta-six-81.vercel.app"],
      "connect-src": ["https://web-beta-six-81.vercel.app", "https://api.github.com"]
    }
  }
}
